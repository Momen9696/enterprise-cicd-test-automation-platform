# Local demo defaults. Replace them before any shared or deployed environment.
# These values are placeholders, not production credentials.

PLATFORM_API_KEY=local-operator-key
PLATFORM_VIEWER_KEY=local-viewer-key
WEBHOOK_SECRET=local-webhook-secret

DATABASE_URL=sqlite:///./data/platform.db
SEED_ON_STARTUP=true
EXECUTION_INLINE=false
EXECUTION_TIMEOUT_SECONDS=120

# Optional. Leave empty to use the shipped pipeline templates only.
GITHUB_TOKEN=
GITHUB_REPOSITORY=
AZURE_ORG=
AZURE_PROJECT=
AZURE_PAT=
NOTIFY_WEBHOOK_URL=
